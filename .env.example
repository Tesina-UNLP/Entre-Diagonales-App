# Runtime error tracking (the project token is public by design).
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_ENABLED=false
EXPO_PUBLIC_APP_ENV=development

# Session Replay stays off until this flag is true AND the user has consented.
EXPO_PUBLIC_POSTHOG_SESSION_REPLAY_ENABLED=false

# Build-only secrets. Put real values in EAS secrets or .env.posthog-cli.local.
# Never use the EXPO_PUBLIC_ prefix for the personal API key.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_HOST=https://us.posthog.com
